<base:WpfUiWindow x:Class="Vexstrap.UI.Elements.Dialogs.FastFlagWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:base="clr-namespace:Vexstrap.UI.Elements.Base"
        Title="Warning" Height="250" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowStyle="None">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar Grid.Row="0" ShowMaximize="False" ShowMinimize="False" Title="Warning" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,16,0,0">
            Are you sure you want to proceed?
            &#x0a;&#x0a;
            Roblox has recently updated their client to ignore FastFlags that are not on their official allowlist. 
            Modifying these flags can cause instability, crashes, or unexpected behavior. Use with caution.
        </TextBlock>

        <ui:Button x:Name="AcceptButton" Grid.Row="2" HorizontalAlignment="Right" Width="100" 
                   Appearance="Danger" Click="AcceptButton_Click" IsEnabled="False" Content="Wait (8)"/>
        
        <ui:Button Grid.Row="2" HorizontalAlignment="Left" Width="100" 
                   Appearance="Secondary" Click="CancelButton_Click" Content="Cancel"/>
    </Grid>
</base:WpfUiWindow>
